# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed web-app origins (CORS whitelist)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/auditorium

# ---- Auth ----
# Use long random strings in production (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Cookie attributes.
#  - COOKIE_DOMAIN: leave BLANK for local dev and most single-host setups (host-only cookie).
#    Do NOT set it to "localhost" — browsers reject Domain=localhost cookies, which drops the
#    refresh cookie and logs users out on every page refresh. (A literal "localhost" here is
#    treated as blank for safety.) Set a real domain like ".example.com" only to share the
#    cookie across subdomains.
#  - Local dev: COOKIE_DOMAIN= (blank), COOKIE_SECURE=false, COOKIE_SAMESITE=strict
#  - Same-site prod (apps + API share a registrable domain): keep 'strict', SECURE=true
#  - Cross-site prod (e.g. apps on Vercel, API on Render): COOKIE_SAMESITE=none, SECURE=true,
#    and leave COOKIE_DOMAIN blank (host-only cookie). 'none' REQUIRES SECURE=true.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# ---- bcrypt ----
BCRYPT_ROUNDS=12

# ---- Business rules ----
NO_SHOW_GRACE_MINUTES=15
VISIBILITY_LEAD_MINUTES=60

# ---- Bootstrap admin (used by `npm run seed:admin`) ----
SEED_ADMIN_MOBILE=9999999999
SEED_ADMIN_PASSWORD=ChangeMe!123

# ---- Field-level encryption (mobiles, unit names) ----
# 32+ char secret. Derives AES-256-GCM + HMAC blind-index keys. Keep STABLE and SECRET;
# rotating it makes existing encrypted data unreadable. e.g. `openssl rand -hex 32`
FIELD_ENCRYPTION_KEY=change-me-field-encryption-key-change-me-32min
