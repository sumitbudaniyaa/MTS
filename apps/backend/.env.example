# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed web-app origins (CORS whitelist)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/auditorium

# ---- Auth ----
# Use long random strings in production (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Cookie attributes
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---- bcrypt ----
BCRYPT_ROUNDS=12

# ---- Business rules ----
NO_SHOW_GRACE_MINUTES=15
VISIBILITY_LEAD_MINUTES=60

# ---- Bootstrap admin (used by `npm run seed:admin`) ----
SEED_ADMIN_MOBILE=9999999999
SEED_ADMIN_PASSWORD=ChangeMe!123
