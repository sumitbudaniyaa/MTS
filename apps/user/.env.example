# Local dev: absolute API URL.
# PRODUCTION (Vercel): set this to the RELATIVE path `/api/v1` instead. vercel.json proxies
# /api/v1/* to the API host, which makes the refresh cookie first-party — served cross-site
# from Render it is a third-party cookie and Safari/iOS drop it, logging the user out on every
# reload while desktop Chrome works fine.
VITE_API_URL=http://localhost:4000/api/v1

# API origin for the WebSocket. REQUIRED in production, because a Vercel rewrite does not carry
# a WebSocket upgrade so the socket must reach the API host directly (safe: the handshake uses
# the access token, not a cookie). Omit in local dev — it is derived from VITE_API_URL.
# VITE_SOCKET_URL=https://mts-65er.onrender.com
